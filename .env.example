# Copia questo file in .env e compila i valori. .env NON va mai committato.

# --- Frontend (Vite espone solo le variabili con prefisso VITE_) ---
# URL base del backend. Con `npm run dev` punta al backend locale; in docker compose viene
# sovrascritto a "/" (proxy nginx). Se non impostato, l'app usa le citazioni incorporate.
VITE_API_URL=http://localhost:3001
# DSN Sentry del progetto (Settings > Projects > Client Keys). Vuoto = Sentry disattivato.
VITE_SENTRY_DSN=
# Nome ambiente mostrato in Sentry: development | staging | production
VITE_APP_ENV=development

# --- Backend ---
PORT=3001
ALLOWED_ORIGIN=*
APP_ENV=development

# --- Porte pubblicate da docker compose ---
FRONTEND_PORT=8080
BACKEND_PORT=3001
